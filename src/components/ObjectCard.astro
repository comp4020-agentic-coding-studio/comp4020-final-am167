---
import ObjectCardBody from "./ObjectCardBody.astro";
import type { History } from "../lib/sky.ts";

// The card an object's history pops up in (ADR 0012, 0015): empty until a
// link to an object, or an object in the sky, is clicked, then filled from
// /object/<id>/panel by src/scripts/object-card.ts. An object's own address
// renders it open, filled, over the catalogue (`history`), and that works
// without JavaScript: the close button is the dialog's own form. On the sky
// it sits beside the beacons and leaves the sky usable (a sheet from the
// bottom on a phone); elsewhere it's centred, over a dimmed page.
interface Props {
  side?: boolean;
  history?: History | null;
  now?: number;
  // the page's own title, for when a card the server opened is closed
  pageTitle?: string;
}
const { side = false, history = null, now = Date.now(), pageTitle } = Astro.props;
---
<dialog id="object-card" class:list={["object-card", { side }]} aria-labelledby="object-card-title" open={history !== null} data-page-title={pageTitle}>
  <div class="object-card-frame">
    <form method="dialog" class="object-card-close-form">
      <button type="submit" class="object-card-close" aria-label="Close">×</button>
    </form>
    <div class="object-card-body history-body">
      {history && <ObjectCardBody history={history} now={now} />}
    </div>
  </div>
</dialog>
<!-- what screen readers hear when a card opens: its name, once -->
<p class="visually-hidden" role="status" id="object-card-status"></p>

<style is:global>
  .object-card {
    width: min(48rem, calc(100vw - 2rem));
    max-height: min(52rem, calc(100svh - 2rem));
    padding: 0;
    border: 1px solid var(--grid-strong);
    border-top: 3px solid var(--amber);
    border-radius: 6px;
    background: var(--night-deep);
    color: var(--ink);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.6);
  }

  .object-card::backdrop {
    background: rgb(6 11 24 / 0.7);
  }

  /* fills the box, so a click that lands on the dialog itself is the backdrop */
  .object-card-frame {
    position: relative;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .object-card h2 {
    margin: 0 2.5rem 0 0;
    font-size: var(--step-2);
    font-variation-settings: "wdth" 112;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .object-card h2:focus {
    outline: none;
  }

  .object-card-close-form {
    margin: 0;
  }

  .object-card-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid transparent;
    border-radius: 4px;
    background: none;
    color: var(--ink-dim);
    font: inherit;
    font-size: var(--step-2);
    line-height: 1;
    cursor: pointer;
  }

  .object-card-close:hover {
    border-color: var(--grid-strong);
    color: var(--amber);
  }

  .object-card .history-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.25rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--grid);
    font-size: var(--step--1);
  }

  .object-card .history-error {
    margin: 0;
    color: var(--ink-dim);
  }

  /* open without JavaScript (an object's own address): not modal, so placed
     over the page by hand */
  .object-card[open]:not(:modal) {
    position: fixed;
    inset: 50% auto auto 50%;
    z-index: 30;
    margin: 0;
    max-height: calc(100svh - 6rem);
    overflow-y: auto;
    transform: translate(-50%, -50%);
  }

  /* over the sky: not modal, beside the beacons' column, so the sky and the
     stations stay in view and usable (another object can be clicked) */
  .object-card.side[open] {
    position: fixed;
    /* under the view buttons, which stay usable */
    inset: 8.25rem auto auto auto;
    right: calc(var(--rail-width, 0rem) + var(--gutter));
    z-index: 20;
    width: min(26rem, 34vw);
    max-height: calc(100svh - 9.5rem);
    margin: 0;
    overflow-y: auto;
    transform: none;
  }

  .object-card.side h2 {
    font-size: var(--step-1);
  }

  /* where the sky is narrower (under about 1440 px), beside the column
     would cover the globe: over the column instead, so the sky stays in
     view (the second review, 2026-10-07) */
  @media (min-width: 52.01rem) and (max-width: 90rem) {
    .object-card.side[open] {
      inset: 4.75rem 0.5rem auto auto;
      width: calc(var(--rail-width, 22rem) - 1rem);
      max-height: calc(100svh - 5.75rem);
    }
  }

  /* on a phone, a sheet from the bottom */
  @media (max-width: 52rem) {
    .object-card.side[open] {
      inset: auto 0 0 0;
      width: 100%;
      max-width: none;
      max-height: 70svh;
      border-width: 3px 0 0;
      border-radius: 10px 10px 0 0;
    }
  }
</style>
