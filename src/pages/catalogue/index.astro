---
import Base from "../../layouts/Base.astro";
import { ago, falling, km } from "../../lib/format.ts";
import { BANDS, fallRate, heightKm, radiusAt } from "../../lib/orbit.ts";
import { catalogue, catalogueCounts, recentCollisions } from "../../lib/sky.ts";
import { blame, collisionOf, couplet, describe, headline } from "../../lib/story.ts";

// The record of everything launched (ADR 0003): what's in orbit now, or
// everything ever, picked by a plain link so it works without JavaScript.
// Callsigns only: a beacon is only heard over the station. Heights are
// worked out from each orbit (ADR 0007), and a script keeps them falling.
// Every fragment traces back to the collision that made it, and every
// collision is told with who it names (ADR 0010).
const { person, operator } = Astro.locals;
const show = Astro.url.searchParams.get("show") === "all" ? "all" : "live";
const rows = catalogue(show, { person, operator: operator?.id ?? null });
const counts = catalogueCounts();
const now = Date.now();
// the latest collisions, told the way the sky page tells them
const COLLISIONS = 50;
const collided = recentCollisions(COLLISIONS);
const kinds = { satellite: "", derelict: "Derelict", debris: "Fragment" } as const;
// a lineage in a narrow column: callsigns keep their hyphens on one line
const whole = (text: string) => text.replaceAll("-", "\u2011");
const fates = {
  live: "In orbit",
  decayed: "Burned up",
  deorbited: "Deorbited",
  destroyed: "Destroyed",
} as const;
const views = [
  { show: "live", href: "/catalogue/", label: `In orbit (${counts.live})` },
  { show: "all", href: "/catalogue/?show=all", label: `Everything ever launched (${counts.all})` },
] as const;
---
<Base title="Kessler: the catalogue" current="catalogue">
  <main class="catalogue-page">
    <h1>The catalogue</h1>
    <p class="lede">
      Everything that has been in the shared sky, kept for good: people's
      satellites, the derelicts that drift in, and every fragment, traced
      back to the collision that made it. Beacons aren't listed: they're only
      heard as a satellite passes over the station (and in the collisions
      below). Every orbit slowly falls and burns up in the end; its record
      stays here.
    </p>

    <nav class="views" aria-label="Show">
      {views.map((v) => (
        <a href={v.href} aria-current={v.show === show ? "page" : undefined}>{v.label}</a>
      ))}
    </nav>

    {rows.length === 0 ? (
      <p class="empty">
        {show === "live" ? "Nothing in orbit." : "Nothing has been launched yet."}{" "}
        <a href="/">Launch the first satellite</a>.
      </p>
    ) : (
      <table data-server-time={now}>
        <thead>
          <tr>
            <th scope="col">Object</th>
            <th scope="col" class="band">Band</th>
            <th scope="col">Height</th>
            <th scope="col">Launched</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((o) => (
            <tr class:list={{ mine: o.mine, gone: o.fate !== "live" }}>
              <th scope="row">
                <span class:list={["swatch", o.kind]} style={`--hue: ${(o.id * 137.508) % 360}`}></span>
                {o.kind === "satellite" ? o.callsign : kinds[o.kind]}
                {o.mine && <span class="yours"> (yours)</span>}
                {o.from && <span class="lineage"> from {whole(collisionOf(o.from))}</span>}
              </th>
              <td class="band">{BANDS[o.band].label}</td>
              {o.fate === "live" ? (
                <td
                  class="height"
                  data-radius={o.radius}
                  data-phase={o.phase}
                  data-period={o.period}
                  data-epoch={o.epoch}
                >
                  <span class="km">{km(heightKm(radiusAt(o, now)))}</span>{" "}
                  <span class="falling">{falling(fallRate(o, now))}</span>
                </td>
              ) : (
                <td class="height"><span aria-hidden="true">—</span><span class="visually-hidden">Gone</span></td>
              )}
              <td><time datetime={new Date(o.launchedAt).toISOString()}>{ago(now - o.launchedAt)}</time></td>
              <td>
                {fates[o.fate]}
                {o.collidedWith && <span class="lineage"> with {whole(describe(o.collidedWith))}</span>}
                {o.fateAt && <> <time class="fate-time" datetime={new Date(o.fateAt).toISOString()}>{ago(now - o.fateAt)}</time></>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <section class="collisions" id="collisions" aria-labelledby="collisions-title">
      <h2 id="collisions-title">Collisions</h2>
      {collided.length === 0 ? (
        <p class="empty">Nothing has collided yet.</p>
      ) : (
        <>
          <p class="lede">
            {collided.length < COLLISIONS ? "Every collision so far" : `The latest ${COLLISIONS} collisions`}, newest
            first: what met, the beacons that met, and who launched what.
          </p>
          <ol class="collision-list">
            {collided.map((c) => (
              <li>
                <p class="collision-title">
                  {headline(c.parties)}{" "}
                  <time datetime={new Date(c.at).toISOString()}>{ago(now - c.at)}</time>
                </p>
                {couplet(c.parties).map(({ callsign, beacon }) => (
                  <p class="collision-beacon"><q>{beacon}</q> {callsign}</p>
                ))}
                <p class="collision-blame">{blame(c.parties)}</p>
              </li>
            ))}
          </ol>
        </>
      )}
    </section>
  </main>

  <script>
    import { falling, km } from "../../lib/format.ts";
    import { fallRate, heightKm, radiusAt } from "../../lib/orbit.ts";

    // Heights fall while you watch: each live row's height and rate, from its
    // orbit and the server's clock, once a second.
    const table = document.querySelector<HTMLTableElement>("table[data-server-time]");
    if (table) {
      const offset = Number(table.dataset.serverTime) - Date.now();
      const rows = [...table.querySelectorAll<HTMLElement>("td.height[data-radius]")].map((cell) => ({
        orbit: {
          radius: Number(cell.dataset.radius),
          phase: Number(cell.dataset.phase),
          period: Number(cell.dataset.period),
          epoch: Number(cell.dataset.epoch),
        },
        height: cell.querySelector(".km")!,
        rate: cell.querySelector(".falling")!,
      }));
      const tick = () => {
        const time = Date.now() + offset;
        for (const { orbit, height, rate } of rows) {
          height.textContent = km(Math.max(0, heightKm(radiusAt(orbit, time))));
          rate.textContent = falling(fallRate(orbit, time));
        }
      };
      setInterval(tick, 1000);
    }
  </script>
</Base>

<style>
  .catalogue-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 3rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: var(--step-2);
    font-weight: 800;
    font-variation-settings: "wdth" 112;
  }

  .lede {
    margin: 0 0 1.25rem;
    color: var(--ink-dim);
    max-width: 38rem;
  }

  .views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1rem;
    font-size: var(--step--1);
  }

  .views a {
    color: var(--ink-dim);
    text-decoration: none;
    padding-block: 0.25rem;
  }

  .views a[aria-current="page"] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--amber);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  th,
  td {
    text-align: left;
    padding: 0.45rem 0.75rem 0.45rem 0;
    border-bottom: 1px solid var(--grid);
    vertical-align: top;
  }

  thead th {
    color: var(--ink-dim);
    font-weight: 600;
  }

  tbody th {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  td {
    white-space: nowrap;
    color: var(--ink-dim);
  }

  .height .km {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .height .falling {
    margin-left: 0.25rem;
    font-size: 0.85em;
    color: #ffb27a;
    font-variant-numeric: tabular-nums;
  }

  tr.gone .height {
    color: var(--ink-dim);
  }

  tr.mine th,
  tr.mine td {
    color: var(--amber);
  }

  tr.gone th {
    color: var(--ink-dim);
    font-weight: 600;
  }

  .yours {
    font-weight: 400;
  }

  .swatch {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: oklch(0.8 0.13 var(--hue));
  }

  .swatch.derelict,
  .swatch.debris {
    background: oklch(0.6 0.02 250);
  }

  .swatch.debris {
    width: 0.4rem;
    height: 0.4rem;
    margin-inline: 0.1rem 0.5rem;
  }

  /* where a fragment came from, and what a destroyed object met: on its own
     line, so long lineages wrap instead of widening the table */
  .lineage {
    display: block;
    font-weight: 400;
    font-size: 0.9em;
    color: var(--ink-dim);
    white-space: normal;
  }

  td:last-child {
    white-space: normal;
  }

  .empty {
    margin: 1rem 0 0;
  }

  .collisions {
    margin-top: 2.5rem;
  }

  .collisions h2 {
    margin: 0 0 0.5rem;
    font-size: var(--step-1);
    font-weight: 700;
    font-variation-settings: "wdth" 112;
  }

  .collision-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collision-list li {
    padding: 0.6rem 0 0.6rem 0.75rem;
    border-left: 3px solid #ff7a45;
    margin-bottom: 0.75rem;
  }

  .collision-list p {
    margin: 0;
  }

  .collision-title {
    font-weight: 700;
  }

  .collision-title time,
  .collision-beacon,
  .collision-blame {
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .collision-title time {
    font-weight: 400;
    margin-left: 0.25rem;
  }

  .collision-beacon q {
    color: var(--ink);
    font-style: italic;
  }

  /* On a phone the table would be wider than the screen: the band goes (the
     height says where it is now), the rate sits under the height, and the
     status loses its time. */
  @media (max-width: 40rem) {
    .band,
    .fate-time {
      display: none;
    }

    .height .falling {
      display: block;
      margin-left: 0;
    }
  }
</style>
