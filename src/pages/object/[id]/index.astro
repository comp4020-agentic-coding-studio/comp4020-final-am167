---
import { historyOf } from "../../../lib/sky.ts";

// An object's own address (ADR 0012): the catalogue, with its card open
// over it (ADR 0015), for a link opened on its own and without JavaScript.
// The address stays this one. What came back from bringing it down or
// boosting it without JavaScript (`deorbited`, `boosted`, `refused`) goes
// along.
const { person, operator } = Astro.locals;
// one address per object: digits, no leading zero
const id = /^[1-9]\d{0,15}$/.test(Astro.params.id ?? "") ? Number(Astro.params.id) : null;
if (id === null || !historyOf(id, { person, operator: operator?.id ?? null })) {
  return new Response("Nothing by that number has been in this sky.", { status: 404 });
}
const params = new URLSearchParams();
for (const name of ["deorbited", "boosted", "refused"]) {
  const value = Astro.url.searchParams.get(name);
  if (value !== null) params.set(name, value);
}
params.set("object", String(id));
return Astro.rewrite(`/catalogue/?${params}`);
---
