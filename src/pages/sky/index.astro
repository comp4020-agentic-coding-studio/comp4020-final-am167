---
import Base from "../../layouts/Base.astro";
import { ago, embed } from "../../lib/format.ts";
import { skyCount } from "../../lib/story.ts";
import { BANDS, bandAt, radiusAt, type Band } from "../../lib/orbit.ts";
import { conjunctions, liveSky, recentCollisions, toPublic } from "../../lib/sky.ts";

// The shared sky. The server renders a summary of what's in orbit (counts per
// band and the latest launches), so the page is complete without JavaScript;
// the full list is the catalogue's. The script draws the sky over the station
// from the same orbits and keeps everything live over the event stream
// (ADR 0004).
const { person, operator } = Astro.locals;
const viewer = { person, operator: operator?.id ?? null };
const now = Date.now();
const sky = liveSky()
  .map((object) => toPublic(object, viewer))
  .sort((a, b) => b.launchedAt - a.launchedAt);
const launchedParam = Number(Astro.url.searchParams.get("launched"));
const launched = sky.find((o) => o.id === launchedParam && o.mine) ?? null;
const mine = sky.find((o) => o.mine) ?? null;
// how many of the latest launches the summary lists (sky.ts keeps it live):
// people's, not the derelicts the server adds or debris
const RECENT = 6;
const recent = sky.filter((o) => o.kind === "satellite").slice(0, RECENT);
const bands = Object.entries(BANDS) as [Band, (typeof BANDS)[Band]][];
// collisions coming, and the latest that happened (ADR 0008, 0010)
const coming = conjunctions(now);
const collided = recentCollisions(5);
---
<Base title="Kessler: the sky" current="sky">
  <main class="sky-page">
    <section class="scene" aria-labelledby="chart-title">
      <h1 id="chart-title" class="visually-hidden">The shared sky</h1>
      <div class="view">
        <canvas
          id="chart"
          role="img"
          aria-label={`The sky over the station: ${skyCount(sky)}. Most rise on the left and set on the right; some go the other way.`}
        ></canvas>
        <div id="scene-labels" class="scene-labels" aria-hidden="true"></div>
        <button type="button" id="zoom" class="zoom" hidden>See the whole sky</button>
        <noscript>
          <p class="no-view">
            The sky and the station need JavaScript. Everything in orbit is
            listed in the <a href="/catalogue/">catalogue</a>.
          </p>
        </noscript>
        <p id="no-webgl" class="no-view" hidden>
          The sky couldn't be drawn here (it needs WebGL, and a connection to
          load it). The station still hears every beacon, and everything in
          orbit is listed in the <a href="/catalogue/">catalogue</a>.
        </p>
      </div>

      <!-- a collision, as it happens: the two beacons and who launched what
           (ADR 0010); over the scene, or under it on a phone -->
      <div id="collision-card" class="collision-card" role="status" hidden></div>

      {launched && (
        <p class="notice launched" id="launched-notice" role="status">
          <strong>{launched.callsign}</strong> is in orbit. Its beacon is broadcast
          each time it passes over the station.
          {!operator && (
            <> <a href="/operator/">Claim a handle</a> to keep it on any device.</>
          )}
        </p>
      )}

      <div class="panels">
        <section class="station" aria-labelledby="station-title">
          <h2 id="station-title">Over the station</h2>
          <!-- a fixed height: three beacons at a time, paged when more are overhead -->
          <div class="heard">
            <ul id="overhead" class="overhead" aria-live="polite"></ul>
            <p id="next-pass" class="next-pass">
              {sky.length === 0 ? "Nothing in orbit yet." : "Beacons are heard here as satellites pass overhead."}
            </p>
          </div>
          <p id="overhead-count" class="overhead-count">&nbsp;</p>
          {mine && <p id="your-pass" class="your-pass" data-id={mine.id}>Yours: {mine.callsign}.</p>}
        </section>

        <section class="summary" aria-labelledby="summary-title" data-recent={RECENT}>
          <div class="summary-head">
            <h2 id="summary-title">Sky now</h2>
            <span id="connection" class="connection" data-state="offline">Not live</span>
          </div>
          <p class="count" id="count">{skyCount(sky)}</p>
          <dl class="band-counts">
            {bands.map(([band, b]) => (
              <div>
                <dt>{b.label}</dt>
                <dd data-band-count={band}>{sky.filter((o) => bandAt(radiusAt(o, now)) === band).length}</dd>
              </div>
            ))}
          </dl>
          <!-- burn-ups, wherever they happen: most are out of the station's view -->
          <p class="sky-news" id="sky-news" role="status" hidden></p>
          <p class="empty" id="empty" hidden={sky.length > 0}>
            The sky is empty. <a href="/">Launch the first satellite</a>.
          </p>
          <ol id="recent" class="recent" aria-label="Latest launches">
            {recent.map((o) => (
              <li class:list={{ mine: o.mine }}>
                <span class="swatch" style={`--hue: ${(o.id * 137.508) % 360}`}></span>
                <span><strong>{o.callsign}</strong>{o.mine && " (yours)"} to {BANDS[o.band].label}</span>
                <time datetime={new Date(o.launchedAt).toISOString()}>{ago(now - o.launchedAt)}</time>
              </li>
            ))}
          </ol>
          <p class="more">
            <a href="/catalogue/">Full catalogue →</a>
            <a href="/kessler/">What's Kessler syndrome?</a>
            <a href="/">{mine ? "Launch another" : "Launch a satellite"}</a>
          </p>
        </section>
      </div>
    </section>

  </main>

  <script type="application/json" id="sky-data" set:html={embed({ serverTime: now, sky, launched: launched?.id ?? null, conjunctions: coming, collisions: collided })} />
  <script>
    import "../../scripts/sky.ts";
  </script>
</Base>

<!-- global: the script rebuilds the latest launches, the station list and
     the scene's labels, and elements it makes carry no scoped-style attribute -->
<style is:global>
  .sky-page {
    --space: #03060e;
    /* the first screen under the site header */
    --scene-height: max(30rem, calc(100svh - 4rem));
  }

  /* The sky fills the first screen; the station panel floats over it. */
  .sky-page .scene {
    position: relative;
  }

  .sky-page .view {
    position: relative;
    height: var(--scene-height);
    overflow: hidden;
    background: var(--space);
  }

  /* fades in from the dark once drawn, so arriving from a launch, which
     ends on that dark, is one continuous shot */
  .sky-page canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s;
  }

  .sky-page canvas.drawn {
    opacity: 1;
  }

  .sky-page .no-view {
    position: absolute;
    inset: auto var(--gutter) 2rem;
    margin: 0;
    color: var(--ink-dim);
  }

  .sky-page .scene-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-size: 0.8rem;
    line-height: 1;
  }

  .sky-page .scene-labels > * {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    will-change: transform;
  }

  .sky-page .sat-label {
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-shadow: 0 0 4px var(--space), 0 0 2px var(--space);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .sky-page .sat-label.shown {
    opacity: 0.8;
  }

  .sky-page .sat-label.overhead,
  .sky-page .sat-label.mine {
    color: var(--amber);
  }

  .sky-page .sat-label.burning {
    color: #ffb27a;
  }

  .sky-page .sat-label.mine.shown {
    opacity: 1;
    font-weight: 800;
  }

  .sky-page .band-label {
    color: var(--ink-dim);
    font-size: var(--step--1);
    font-weight: 700;
    font-variation-settings: "wdth" 112;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: 0 0 4px var(--space), 0 0 2px var(--space);
  }

  .sky-page .station-label {
    color: var(--amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 0 4px var(--space);
  }

  /* a collision's flash lighting the whole view for a moment (scene.ts) */
  .sky-page .scene-labels > .impact-veil {
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: auto;
  }

  .sky-page .impact-pointer {
    padding: 0.3rem 0.55rem;
    border: 1px solid #ff7a45;
    border-radius: 3px;
    background: rgb(24 10 6 / 0.8);
    color: #ffb27a;
    font-weight: 700;
  }

  .sky-page .your-pointer {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--amber-dim);
    border-radius: 3px;
    background: rgb(3 6 14 / 0.75);
    color: var(--amber);
    font-weight: 700;
  }

  .sky-page .launch-pulse::before {
    content: "";
    position: absolute;
    left: -1.5rem;
    top: -1.5rem;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--amber);
    border-radius: 50%;
    animation: pulse 1.5s ease-out infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(0.3);
      opacity: 1;
    }
    to {
      transform: scale(1.3);
      opacity: 0;
    }
  }

  .sky-page .zoom {
    position: absolute;
    top: 1.25rem;
    right: var(--gutter);
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--grid-strong);
    border-radius: 4px;
    background: rgb(6 11 24 / 0.72);
    backdrop-filter: blur(6px);
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  .sky-page .zoom:hover {
    border-color: var(--amber-dim);
    color: var(--amber);
  }

  .sky-page .panels {
    position: absolute;
    top: 1.25rem;
    left: var(--gutter);
    width: min(24rem, 40vw);
    display: grid;
    gap: 0.75rem;
  }

  .sky-page h2 {
    margin: 0 0 0.5rem;
    font-size: var(--step-1);
    font-weight: 700;
    font-variation-settings: "wdth" 112;
  }

  /* A toast over the top of the scene, so it never moves the panels; the
     script fades it after a few seconds. */
  .sky-page .notice {
    position: absolute;
    top: 1.25rem;
    left: 50%;
    z-index: 1;
    width: min(28rem, calc(100% - 2 * var(--gutter)));
    margin: 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--amber);
    background: rgb(20 16 10 / 0.85);
    backdrop-filter: blur(6px);
    transform: translateX(-50%);
    transition: opacity 0.6s;
  }

  .sky-page .notice.fading {
    opacity: 0;
  }

  /* A collision, as it happens (ADR 0010): over the bottom right of the
     scene, clear of the station panel; the script fades it after a while. */
  .sky-page .collision-card {
    position: absolute;
    right: var(--gutter);
    bottom: 1.25rem;
    z-index: 1;
    width: min(26rem, 40vw);
    padding: 0.75rem 1rem;
    border-left: 3px solid #ff7a45;
    background: rgb(24 10 6 / 0.85);
    backdrop-filter: blur(6px);
    transition: opacity 0.8s;
  }

  .sky-page .collision-card.fading {
    opacity: 0;
  }

  .sky-page .collision-card p {
    margin: 0;
  }

  .sky-page .collision-title {
    font-weight: 800;
    color: #ffb27a;
  }

  .sky-page .collision-card .collision-beacon {
    margin-top: 0.35rem;
    color: var(--ink-dim);
  }

  .sky-page .collision-beacon q {
    color: var(--ink);
    font-style: italic;
  }

  .sky-page .collision-card .collision-blame {
    margin-top: 0.5rem;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  /* The panel never changes height: three beacon slots, each a callsign and
     at most two lines of beacon, a count line, and two lines for yours. */
  .sky-page .station {
    --slot: 3.95rem;
    padding: 1rem;
    border: 1px solid var(--amber-dim);
    border-radius: 4px;
    background: rgb(6 11 24 / 0.72);
    backdrop-filter: blur(6px);
  }

  .sky-page .heard {
    height: calc(3 * var(--slot) + 2 * 0.5rem);
    overflow: hidden;
  }

  .sky-page .overhead {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .sky-page .overhead li {
    display: grid;
    align-content: start;
    height: var(--slot);
    animation: heard 0.4s ease-out;
  }

  @keyframes heard {
    from {
      opacity: 0;
    }
  }

  .sky-page .overhead .callsign {
    font-size: var(--step--1);
    color: var(--amber);
    font-weight: 700;
  }

  .sky-page .overhead .beacon {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: var(--step-0);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .sky-page .next-pass {
    margin: 0;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .sky-page .overhead:not(:empty) + .next-pass {
    display: none;
  }

  .sky-page .overhead-count {
    margin: 0.5rem 0 0;
    color: var(--ink-dim);
    font-size: 0.75rem;
  }

  .sky-page .your-pass {
    min-height: calc(2 * 1.5 * var(--step--1));
    margin: 0.6rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--amber-dim);
    font-size: var(--step--1);
    box-sizing: content-box;
  }

  .sky-page .summary {
    padding: 0.85rem 1rem;
    border: 1px solid var(--grid-strong);
    border-radius: 4px;
    background: rgb(6 11 24 / 0.72);
    backdrop-filter: blur(6px);
    font-size: var(--step--1);
  }

  .sky-page .summary-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .sky-page .summary h2 {
    font-size: var(--step-0);
  }

  .sky-page .connection {
    color: var(--ink-dim);
  }

  .sky-page .connection::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--ink-dim);
  }

  .sky-page .connection[data-state="live"]::before {
    background: #7fd6a0;
  }

  .sky-page .count {
    margin: 0 0 0.4rem;
    color: var(--ink-dim);
  }

  .sky-page .band-counts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0 0 0.75rem;
  }

  .sky-page .band-counts div {
    padding: 0.35rem 0.5rem;
    border-radius: 3px;
    background: rgb(58 87 129 / 0.18);
  }

  .sky-page .band-counts dt {
    color: var(--ink-dim);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sky-page .band-counts dd {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
  }

  .sky-page .recent {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .sky-page .recent li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem;
  }

  .sky-page .recent li > span:nth-child(2) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sky-page .recent time {
    color: var(--ink-dim);
    white-space: nowrap;
  }

  .sky-page .recent li.mine {
    color: var(--amber);
  }

  .sky-page .swatch {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: oklch(0.8 0.13 var(--hue));
  }

  .sky-page .empty {
    margin: 0;
  }

  .sky-page .sky-news {
    margin: 0 0 0.6rem;
    padding: 0.35rem 0.5rem;
    border-radius: 3px;
    background: rgb(255 120 40 / 0.1);
    color: #ffb27a;
  }

  .sky-page .sky-news::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: #ff9a4a;
    box-shadow: 0 0 6px 2px rgb(255 120 40 / 0.6);
  }

  .sky-page .more {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0.75rem 0 0;
  }

  /* On a shorter screen the summary gives up its latest launches, then its
     counts, so the panels always fit over the sky without scrolling. */
  @media (min-width: 52.01rem) and (max-height: 56rem) {
    .sky-page .recent li:nth-child(n + 4) {
      display: none;
    }
  }

  @media (min-width: 52.01rem) and (max-height: 46rem) {
    .sky-page .recent {
      display: none;
    }
  }

  @media (min-width: 52.01rem) and (max-height: 40rem) {
    .sky-page .band-counts {
      display: none;
    }
  }

  /* On a phone the panel would cover the sky, so it follows it instead. */
  @media (max-width: 52rem) {
    .sky-page {
      --scene-height: 52svh;
    }

    .sky-page .panels {
      position: static;
      width: auto;
      padding: 1rem var(--gutter) 2rem;
    }

    .sky-page .notice {
      position: static;
      width: auto;
      margin: 1rem var(--gutter) 0;
      transform: none;
    }

    /* under the scene, like the notice: over it, a long one hides the station */
    .sky-page .collision-card {
      position: static;
      width: auto;
      margin: 1rem var(--gutter) 0;
      padding: 0.6rem 0.8rem;
      font-size: var(--step--1);
    }
  }
</style>
