---
import Base from "../../layouts/Base.astro";
import FirstLaunch from "../../components/FirstLaunch.astro";
import ManoeuvreDialogs from "../../components/ManoeuvreDialogs.astro";
import ObjectCard from "../../components/ObjectCard.astro";
import HeardCard from "../../components/HeardCard.astro";
import { ago, embed } from "../../lib/format.ts";
import { listeningNow, skyCount } from "../../lib/story.ts";
import { BANDS, bandAt, radiusAt, type Band } from "../../lib/orbit.ts";
import { STATIONS } from "../../lib/stations.ts";
import { audience } from "../../lib/events.ts";
import { HEARD_FEED, heardCounts, listenerKey, recentlyHeard } from "../../lib/heard.ts";
import { dayOf, questionOn } from "../../lib/questions.ts";
import { conjunctions, isFirstLaunch, liveSky, recentCollisions, toPublic } from "../../lib/sky.ts";

// The shared sky. The server renders a summary of what's in orbit (counts per
// band and the latest launches), and what the stations have heard (ADR
// 0016), so the page reads without JavaScript; the full list is the
// catalogue's. The script draws the whole sky, or the horizon over a ground
// station, from the same orbits, says what each station hears, and keeps
// everything live over the event stream (ADR 0004, 0014).
const { person, operator } = Astro.locals;
const viewer = { person, operator: operator?.id ?? null };
const now = Date.now();
const live = liveSky();
const sky = live.map((object) => toPublic(object, viewer)).sort((a, b) => b.launchedAt - a.launchedAt);
// what was heard, and by how many; and who's listening, this viewer
// included (their stream opens as the page does)
const heard = recentlyHeard(HEARD_FEED, viewer, now);
const heardBy = heardCounts(live.map((o) => o.id));
const ears = audience();
const listening = ears.size + (ears.has(listenerKey(viewer)) ? 0 : 1);
// what the stations ask today (ADR 0018)
const question = questionOn(dayOf(now));
const launchedParam = Number(Astro.url.searchParams.get("launched"));
const launched = sky.find((o) => o.id === launchedParam && o.mine) ?? null;
const mine = sky.find((o) => o.mine) ?? null;
// straight after someone's first launch ever, the sky explains itself
const first = launched !== null && isFirstLaunch(viewer, launched.id);
// how many of the latest launches the summary lists (sky.ts keeps it live):
// people's, not the derelicts the server adds or debris
const RECENT = 6;
const recent = sky.filter((o) => o.kind === "satellite").slice(0, RECENT);
const bands = Object.entries(BANDS) as [Band, (typeof BANDS)[Band]][];
// collisions coming, and the latest that happened (ADR 0008, 0010)
const coming = conjunctions(now);
const collided = recentCollisions(5);
// the view it opens on (ADR 0014): the whole sky, or straight after a
// launch the horizon over Canberra, where the launch's camera ends
const view = launched ? "canberra" : null;
---
<Base title="Kessler: the sky" current="sky">
  <main class="sky-page">
    <!-- the sky, and over it the summary; beside it (under it on a phone)
         the beacons: what the stations hear, and what they've heard -->
    <div class="scene">
      <h1 id="chart-title" class="visually-hidden">The shared sky</h1>
      <div class="view">
        <canvas
          id="chart"
          role="img"
          aria-label={view
            ? `The sky over Canberra: ${skyCount(sky)}. Most rise on the left and set on the right; some go the other way.`
            : `The whole sky, with the three ground stations: ${skyCount(sky)}.`}
        ></canvas>
        <div id="scene-labels" class="scene-labels" aria-hidden="true"></div>
        <!-- the whole planet, or the horizon over one station (ADR 0014) -->
        <div id="views" class="views" role="group" aria-label="View" hidden>
          <button type="button" data-view="" aria-pressed={view === null ? "true" : "false"}>Whole sky</button>
          {STATIONS.map((s) => (
            <button type="button" data-view={s.id} aria-pressed={view === s.id ? "true" : "false"}>{s.name}</button>
          ))}
        </div>
        <noscript>
          <p class="no-view">
            The sky and the live beacons need JavaScript. What the stations
            have heard is listed beside it, and everything in orbit is in the
            <a href="/catalogue/">catalogue</a>.
          </p>
        </noscript>
        <p id="no-webgl" class="no-view" hidden>
          The sky couldn't be drawn here (it needs WebGL, and a connection to
          load it). The stations still hear every beacon, and everything in
          orbit is listed in the <a href="/catalogue/">catalogue</a>.
        </p>
      </div>

      <!-- a collision, as it happens: the two beacons and who launched what
           (ADR 0010); over the scene, or under it on a phone -->
      <div id="collision-card" class="collision-card" role="status" hidden></div>

      {launched && (
        <p class="notice launched" id="launched-notice" role="status">
          <strong>{launched.callsign}</strong> is in orbit. Its beacon is broadcast
          each time it passes over a ground station.
          {!operator && (
            <> <a href="/operator/?back=sky">Claim a handle</a> to keep it on any device.</>
          )}
        </p>
      )}

      <div class="panels">
        <section class="summary" aria-labelledby="summary-title" data-recent={RECENT}>
          <div class="summary-head">
            <h2 id="summary-title">Sky now</h2>
            <span id="connection" class="connection" data-state="offline">Not live</span>
          </div>
          <p class="count" id="count">{skyCount(sky)}</p>
          <p class="pick-hint" id="pick-hint" hidden><span>Click anything in the sky to see its history</span>, or find it in the <a href="/catalogue/">catalogue</a>.</p>
          <dl class="band-counts">
            {bands.map(([band, b]) => (
              <div>
                <dt>{b.label}</dt>
                <dd data-band-count={band}>{sky.filter((o) => bandAt(radiusAt(o, now)) === band).length}</dd>
              </div>
            ))}
          </dl>
          <!-- burn-ups, wherever they happen: most happen away from the stations -->
          <p class="sky-news" id="sky-news" role="status" hidden></p>
          <p class="empty" id="empty" hidden={sky.length > 0}>
            The sky is empty. <a href="/">Launch the first satellite</a>.
          </p>
          <ol id="recent" class="recent" aria-label="Latest launches">
            {recent.map((o) => (
              <li class:list={{ mine: o.mine }}>
                <span class="swatch" style={`--hue: ${(o.id * 137.508) % 360}`}></span>
                <span><a href={`/object/${o.id}/`} data-history={o.id}><strong>{o.callsign}</strong></a>{o.mine && " (yours)"} to {BANDS[o.band].label}</span>
                <time datetime={new Date(o.launchedAt).toISOString()}>{ago(now - o.launchedAt)}</time>
              </li>
            ))}
          </ol>
          <p class="more">
            <a href="/catalogue/">Full catalogue →</a>
            <a href="/kessler/">What's Kessler syndrome?</a>
            <a href="/">{mine ? "Launch another" : "Launch a satellite"}</a>
          </p>
        </section>
      </div>
    </div>

    <aside class="rail" aria-label="Beacons">
      <section class="station" aria-labelledby="station-title">
        <div class="rail-head">
          <h2 id="station-title">Beacons</h2>
          <span class="listening" id="listening" data-listening={listening}>{listeningNow(listening)}</span>
        </div>
        <p class="station-note">What the three ground stations hear now. Everyone listening hears it at the same moment.</p>
        <p class="today">
          <span class="today-kicker">Today the stations ask</span>
          <q>{question}</q>
          <a href="/">Answer it</a>
        </p>
        <!-- a row for each station (ADR 0014), each a fixed height: what it
             hears now, taking turns when more than one is overhead, or
             what's next -->
        <ol class="posts">
          {STATIONS.map((s) => (
            <li class="post" data-station={s.id}>
              <p class="post-head">
                <span class="post-name">{s.name}</span>
                <span class="post-next" data-next></span>
              </p>
              <p class="post-heard" data-heard aria-live="polite"></p>
            </li>
          ))}
        </ol>
        <!-- what yours is doing; boosting it or bringing it down is on its
             card and in Yours (ADR 0015), never here, since this line
             moves on to whichever of yours passes next -->
        {mine && <p id="your-pass" class="your-pass" data-id={mine.id}>Yours: {mine.callsign}.</p>}
        {mine && <p class="your-manage"><a href="/catalogue/?show=mine">Boost or bring down yours</a></p>}
      </section>

      <!-- what the stations have heard while someone was listening, each
           beacon once, the latest pass first (ADR 0016) -->
      <section class="heard" aria-labelledby="heard-title">
        <h2 id="heard-title">Heard</h2>
        <p class="heard-note">Each beacon the stations picked up while someone was listening, the latest first.</p>
        <ol class="feed" id="feed" data-size={HEARD_FEED}>
          {heard.map((item) => <HeardCard item={item} now={now} />)}
        </ol>
        <p class="feed-empty" id="feed-empty" hidden={heard.length > 0}>
          Nothing heard yet. A beacon is heard when its satellite comes over a
          station while someone is listening, as you are now.
        </p>
      </section>
    </aside>

    <!-- an object's history (ADR 0012), opened by clicking it in the sky or
         a name in the latest launches, with your own's controls (ADR 0015) -->
    <ObjectCard side />
    <ManoeuvreDialogs />
    {first && <FirstLaunch callsign={launched!.callsign ?? "Your satellite"} signedIn={Boolean(operator)} />}
  </main>

  <script type="application/json" id="sky-data" set:html={embed({ serverTime: now, sky, launched: launched?.id ?? null, view, conjunctions: coming, collisions: collided, heard, heardBy, listening })} />
  <script>
    import "../../scripts/sky.ts";
  </script>
</Base>

<!-- global: the script rebuilds the latest launches, the beacon rows and
     the scene's labels, and elements it makes carry no scoped-style attribute -->
<style is:global>
  .sky-page {
    --space: #03060e;
    /* the first screen under the site header */
    --scene-height: max(30rem, calc(100svh - 4rem));
    /* the beacons' column beside the sky */
    --rail-width: clamp(21rem, 27vw, 30rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--rail-width);
  }

  /* The sky fills the first screen beside the beacons; the summary floats
     over it. */
  .sky-page .scene {
    position: relative;
    min-width: 0;
  }

  .sky-page .view {
    position: relative;
    height: var(--scene-height);
    overflow: hidden;
    background: var(--space);
  }

  /* fades in from the dark once drawn, so arriving from a launch, which
     ends on that dark, is one continuous shot */
  .sky-page canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s;
  }

  .sky-page canvas.drawn {
    opacity: 1;
  }

  .sky-page .no-view {
    position: absolute;
    inset: auto var(--gutter) 2rem;
    margin: 0;
    color: var(--ink-dim);
  }

  .sky-page .scene-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-size: 0.8rem;
    line-height: 1;
  }

  .sky-page .scene-labels > * {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    will-change: transform;
  }

  .sky-page .sat-label {
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-shadow: 0 0 4px var(--space), 0 0 2px var(--space);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .sky-page .sat-label.shown {
    opacity: 0.8;
  }

  .sky-page .sat-label.overhead,
  .sky-page .sat-label.mine {
    color: var(--amber);
  }

  .sky-page .sat-label.burning {
    color: #ffb27a;
  }

  .sky-page .sat-label.mine.shown {
    opacity: 1;
    font-weight: 800;
  }

  .sky-page .band-label {
    color: var(--ink-dim);
    font-size: var(--step--1);
    font-weight: 700;
    font-variation-settings: "wdth" 112;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-shadow: 0 0 4px var(--space), 0 0 2px var(--space);
  }

  .sky-page .station-label {
    color: var(--amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 0 4px var(--space);
  }

  /* a collision's flash lighting the whole view for a moment (scene.ts) */
  .sky-page .scene-labels > .impact-veil {
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: auto;
  }

  .sky-page .impact-pointer {
    padding: 0.3rem 0.55rem;
    border: 1px solid #ff7a45;
    border-radius: 3px;
    background: rgb(24 10 6 / 0.8);
    color: #ffb27a;
    font-weight: 700;
  }

  .sky-page .your-pointer {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--amber-dim);
    border-radius: 3px;
    background: rgb(3 6 14 / 0.75);
    color: var(--amber);
    font-weight: 700;
  }

  .sky-page .launch-pulse::before {
    content: "";
    position: absolute;
    left: -1.5rem;
    top: -1.5rem;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--amber);
    border-radius: 50%;
    animation: pulse 1.5s ease-out infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(0.3);
      opacity: 1;
    }
    to {
      transform: scale(1.3);
      opacity: 0;
    }
  }

  /* the whole sky, or the horizon over one station: one choice of four */
  .sky-page .views {
    position: absolute;
    top: 1.25rem;
    right: var(--gutter);
    display: flex;
    border: 1px solid var(--grid-strong);
    border-radius: 4px;
    background: rgb(6 11 24 / 0.72);
    backdrop-filter: blur(6px);
    overflow: hidden;
  }

  .sky-page .views[hidden] {
    display: none;
  }

  .sky-page .views button {
    padding: 0.5rem 0.75rem;
    border: 0;
    border-left: 1px solid var(--grid-strong);
    background: none;
    color: var(--ink-dim);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  .sky-page .views button:first-child {
    border-left: 0;
  }

  .sky-page .views button:hover {
    color: var(--amber);
  }

  .sky-page .views button[aria-pressed="true"] {
    background: rgb(242 165 65 / 0.16);
    color: var(--amber);
  }

  .sky-page .panels {
    position: absolute;
    top: 1.25rem;
    left: var(--gutter);
    width: min(26rem, 40vw);
    display: grid;
    gap: 0.75rem;
  }

  .sky-page h2 {
    margin: 0 0 0.5rem;
    font-size: var(--step-1);
    font-weight: 700;
    font-variation-settings: "wdth" 112;
  }

  /* A toast over the top of the scene, so it never moves the panels; the
     script fades it after a few seconds. */
  .sky-page .notice {
    position: absolute;
    top: 1.25rem;
    left: 50%;
    z-index: 1;
    width: min(28rem, calc(100% - 2 * var(--gutter)));
    margin: 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--amber);
    background: rgb(20 16 10 / 0.85);
    backdrop-filter: blur(6px);
    transform: translateX(-50%);
    transition: opacity 0.6s;
  }

  .sky-page .notice.fading {
    opacity: 0;
  }

  /* A collision, as it happens (ADR 0010): over the bottom right of the
     scene, clear of the beacons; the script fades it after a while. */
  .sky-page .collision-card {
    position: absolute;
    right: var(--gutter);
    bottom: 1.25rem;
    z-index: 1;
    width: min(26rem, 40vw);
    padding: 0.75rem 1rem;
    border-left: 3px solid #ff7a45;
    background: rgb(24 10 6 / 0.85);
    backdrop-filter: blur(6px);
    transition: opacity 0.8s;
  }

  .sky-page .collision-card.fading {
    opacity: 0;
  }

  .sky-page .collision-card p {
    margin: 0;
  }

  .sky-page .collision-title {
    font-weight: 800;
    color: #ffb27a;
  }

  .sky-page .collision-card .collision-beacon {
    margin-top: 0.35rem;
    color: var(--ink-dim);
  }

  .sky-page .collision-beacon q {
    color: var(--ink);
    font-style: italic;
  }

  .sky-page .collision-card .collision-blame {
    margin-top: 0.5rem;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .sky-page .pick-hint {
    margin: 0.25rem 0 0;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .sky-page .recent a {
    text-decoration-color: var(--grid-strong);
  }

  .sky-page .recent a:hover {
    text-decoration-color: currentColor;
  }

  /* The beacons (ADR 0016): a column beside the sky, as tall as it. At the
     top, what each station hears now; under it, scrolling, what they've
     heard. */
  .sky-page .rail {
    display: flex;
    flex-direction: column;
    height: var(--scene-height);
    border-left: 1px solid var(--grid);
    background: var(--night-deep);
  }

  /* a row for each ground station (ADR 0014), each a fixed height (its
     name, and up to four lines of beacon), so the column never jumps as
     satellites come and go */
  .sky-page .station {
    flex: none;
    padding: 1rem 1.1rem 0.9rem;
    border-bottom: 1px solid var(--grid);
  }

  .sky-page .rail-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .sky-page .station h2 {
    margin-bottom: 0.15rem;
  }

  /* who else is here: the people listening now */
  .sky-page .listening {
    color: var(--ink-dim);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .sky-page .listening::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 6px 1px rgb(242 165 65 / 0.5);
  }

  /* the stations' question today (ADR 0018) */
  .sky-page .today {
    margin: 0 0 0.75rem;
    padding: 0.45rem 0.65rem 0.5rem;
    border-left: 3px solid var(--amber);
    background: rgb(242 165 65 / 0.08);
    font-size: var(--step--1);
  }

  .sky-page .today-kicker {
    display: block;
    color: var(--ink-dim);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sky-page .today q {
    font-size: var(--step-0);
    font-style: italic;
  }

  .sky-page .today a {
    margin-left: 0.4rem;
    white-space: nowrap;
  }

  .sky-page .heard-question,
  .sky-page .collision-question {
    margin-top: 0.3rem;
    color: var(--ink-dim);
    font-size: 0.8rem;
  }

  .sky-page .heard-question q,
  .sky-page .collision-question q {
    color: var(--ink);
    font-style: italic;
  }

  /* What's been heard: a feed, newest first, scrolling inside the column */
  .sky-page .heard {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0.9rem 1.1rem 1.25rem;
    scrollbar-color: var(--grid-strong) transparent;
  }

  .sky-page .heard h2 {
    margin-bottom: 0.15rem;
    font-size: var(--step-0);
  }

  .sky-page .heard-note,
  .sky-page .feed-empty {
    margin: 0 0 0.75rem;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .sky-page .feed {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sky-page .heard-item {
    padding: 0.7rem 0.8rem 0.75rem;
    border: 1px solid var(--grid);
    border-radius: 6px;
    background: rgb(14 26 48 / 0.6);
  }

  .sky-page .heard-item.mine {
    border-color: var(--amber-dim);
  }

  .sky-page .heard-item.fresh {
    animation: fresh 2.5s ease-out;
  }

  @keyframes fresh {
    from {
      border-color: var(--amber);
      background: rgb(242 165 65 / 0.14);
    }
  }

  .sky-page .heard-item p {
    margin: 0;
  }

  .sky-page .heard-who {
    display: flex;
    align-items: baseline;
    gap: 0.25rem 0.45rem;
    font-size: var(--step--1);
  }

  .sky-page .heard-who a {
    color: var(--ink);
    text-decoration: none;
  }

  .sky-page .heard-who a:hover {
    color: var(--amber);
    text-decoration: underline;
  }

  .sky-page .heard-handle {
    overflow: hidden;
    color: var(--ink-dim);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sky-page .heard-item.mine .heard-handle {
    color: var(--amber);
  }

  .sky-page .heard-when {
    margin-left: auto;
    color: var(--ink-dim);
    white-space: nowrap;
  }

  .sky-page .heard-line {
    margin-top: 0.35rem;
    font-size: 1.05rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .sky-page .heard-meta {
    margin-top: 0.4rem;
    color: var(--ink-dim);
    font-size: 0.8rem;
  }

  .sky-page .heard-item.gone .heard-line {
    color: var(--ink-dim);
  }

  .sky-page .station-note {
    margin: 0 0 0.75rem;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .sky-page .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .sky-page .post {
    --beacon-size: 1.05rem;
    padding-left: 0.7rem;
    border-left: 2px solid var(--grid-strong);
  }

  .sky-page .post.live {
    border-left-color: var(--amber);
  }

  .sky-page .post p {
    margin: 0;
  }

  .sky-page .post-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .sky-page .post-name {
    color: var(--ink-dim);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .sky-page .post.live .post-name {
    color: var(--amber);
  }

  .sky-page .post-next {
    overflow: hidden;
    color: var(--ink-dim);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* four lines of beacon, always: room for one at its longest (140) */
  .sky-page .post-heard {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    height: calc(4 * 1.25 * var(--beacon-size));
    overflow: hidden;
    font-size: var(--beacon-size);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .sky-page .post-heard .callsign {
    margin-right: 0.4em;
    color: var(--amber);
