---
import Base from "../../layouts/Base.astro";
import { ago, embed } from "../../lib/format.ts";
import { BANDS } from "../../lib/orbit.ts";
import { liveSky, toPublic } from "../../lib/sky.ts";

// The shared sky. The server renders the catalogue of what's in orbit, so the
// page is complete without JavaScript; the script draws the chart from the
// same orbits and keeps everything live over the event stream (ADR 0004).
const { person } = Astro.locals;
const now = Date.now();
const sky = liveSky()
  .map((object) => toPublic(object, person))
  .sort((a, b) => b.launchedAt - a.launchedAt);
const launchedParam = Number(Astro.url.searchParams.get("launched"));
const launched = sky.find((o) => o.id === launchedParam && o.mine) ?? null;
const mine = sky.find((o) => o.mine) ?? null;
const count = (n: number) => `${n} satellite${n === 1 ? "" : "s"} in orbit`;
---
<Base title="Kessler: the sky" current="sky">
  <main class="sky-page">
    {launched && (
      <p class="notice launched" id="launched-notice">
        <strong>{launched.callsign}</strong> is in orbit. Its beacon is broadcast
        each time it passes over the station.
      </p>
    )}

    <section class="chart-wrap" aria-labelledby="chart-title">
      <h1 id="chart-title" class="visually-hidden">The shared sky</h1>
      <canvas
        id="chart"
        role="img"
        aria-label={`Orbital chart: ${count(sky.length)} around the planet. The ground station is at the top.`}
      ></canvas>
      <noscript>
        <p class="noscript">The chart and the station need JavaScript. Everything in orbit is listed below.</p>
      </noscript>
    </section>

    <aside class="side">
      <section class="station" aria-labelledby="station-title">
        <h2 id="station-title">Over the station</h2>
        <ul id="overhead" class="overhead" aria-live="polite"></ul>
        {mine && <p id="your-pass" class="your-pass" data-id={mine.id}>Yours: {mine.callsign}.</p>}
        <p id="next-pass" class="next-pass">
          {sky.length === 0 ? "Nothing in orbit yet." : "Beacons are heard here as satellites pass overhead."}
        </p>
      </section>

      <section class="catalogue" aria-labelledby="catalogue-title">
        <h2 id="catalogue-title">In orbit</h2>
        <p class="count">
          <span id="count">{count(sky.length)}</span>
          <span id="connection" class="connection" data-state="offline">Not live</span>
        </p>
        <p class="help">Beacons are only heard over the station.</p>
        <p class="empty" id="empty" hidden={sky.length > 0}>
          The sky is empty. <a href="/">Launch the first satellite</a>.
        </p>
        <table hidden={sky.length === 0} id="catalogue">
          <thead>
            <tr>
              <th scope="col">Callsign</th>
              <th scope="col">Band</th>
              <th scope="col">Launched</th>
            </tr>
          </thead>
          <tbody id="rows">
            {sky.map((o) => (
              <tr data-id={o.id} class:list={{ mine: o.mine }}>
                <th scope="row">
                  <span class="swatch" style={`--hue: ${(o.id * 137.508) % 360}`}></span>
                  {o.callsign}
                  {o.mine && <span class="yours"> (yours)</span>}
                </th>
                <td>{BANDS[o.band].label}</td>
                <td><time datetime={new Date(o.launchedAt).toISOString()}>{ago(now - o.launchedAt)}</time></td>
              </tr>
            ))}
          </tbody>
        </table>
        {!mine && <p class="cta"><a href="/">Launch a satellite</a></p>}
      </section>
    </aside>
  </main>

  <script type="application/json" id="sky-data" set:html={embed({ serverTime: now, sky, launched: launched?.id ?? null })} />
  <script>
    import "../../scripts/sky.ts";
  </script>
</Base>

<!-- global: the script rebuilds the table and the station list, and
     elements it makes carry no scoped-style attribute -->
<style is:global>
  .sky-page {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 1fr);
    gap: 1.5rem var(--gutter);
    padding: 0 var(--gutter) 2rem;
    align-items: start;
  }

  .sky-page .chart-wrap {
    position: sticky;
    top: 1rem;
    aspect-ratio: 1;
    max-height: calc(100vh - 6rem);
    width: 100%;
    margin-inline: auto;
  }

  .sky-page canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sky-page .noscript {
    color: var(--ink-dim);
  }

  .sky-page .side {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .sky-page h2 {
    margin: 0 0 0.5rem;
    font-size: var(--step-1);
    font-weight: 700;
    font-variation-settings: "wdth" 112;
  }

  .sky-page .notice {
    margin: 0;
    padding: 0.75rem;
    border-left: 3px solid var(--amber);
    background: rgb(242 165 65 / 0.08);
  }

  .sky-page .launched {
    grid-column: 1 / -1;
  }

  .sky-page .your-pass {
    margin: 0.75rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--amber-dim);
    font-size: var(--step--1);
  }

  .sky-page .station {
    padding: 1rem;
    border: 1px solid var(--amber-dim);
    border-radius: 4px;
    background: rgb(242 165 65 / 0.05);
    min-height: 8.5rem;
  }

  .sky-page .overhead {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .sky-page .overhead li {
    display: grid;
  }

  .sky-page .overhead .callsign {
    font-size: var(--step--1);
    color: var(--amber);
    font-weight: 700;
  }

  .sky-page .overhead .beacon {
    font-size: var(--step-1);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .sky-page .next-pass {
    margin: 0.5rem 0 0;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .sky-page .overhead:not(:empty) + .next-pass {
    display: none;
  }

  .sky-page .count {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.5rem;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .sky-page .connection::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--ink-dim);
  }

  .sky-page .connection[data-state="live"]::before {
    background: #7fd6a0;
  }

  .sky-page table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .sky-page th,
  .sky-page td {
    text-align: left;
    padding: 0.45rem 0.5rem 0.45rem 0;
    border-bottom: 1px solid var(--grid);
    vertical-align: top;
  }

  .sky-page thead th {
    color: var(--ink-dim);
    font-weight: 600;
  }

  .sky-page tbody th {
    white-space: nowrap;
    font-weight: 700;
  }

  .sky-page td {
    white-space: nowrap;
    color: var(--ink-dim);
  }

  .sky-page tr.mine th,
  .sky-page tr.mine td {
    color: var(--amber);
  }

  .sky-page .yours {
    font-weight: 400;
  }

  .sky-page .swatch {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: oklch(0.8 0.13 var(--hue));
  }

  .sky-page .help {
    margin: 0 0 0.5rem;
    color: var(--ink-dim);
    font-size: var(--step--1);
  }

  .sky-page .empty,
  .sky-page .cta {
    margin: 0.75rem 0 0;
  }

  @media (max-width: 52rem) {
    .sky-page {
      grid-template-columns: minmax(0, 1fr);
    }

    .sky-page .chart-wrap {
      position: static;
      max-height: none;
    }

  }
</style>
