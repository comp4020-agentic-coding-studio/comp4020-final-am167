---
import { readFileSync } from "node:fs";
import { marked } from "marked";

const html = await marked.parse(readFileSync("README.md", "utf8"));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>README</title>
  </head>
  <body>
    <main set:html={html} />
  </body>
</html>
