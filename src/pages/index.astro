---
import Base from "../layouts/Base.astro";
import { every, lasting } from "../lib/format.ts";
import { BEACON_MAX, CALLSIGN_MAX, readLaunch, type LaunchErrors, type LaunchValues } from "../lib/launch.ts";
import { BANDS, lifetimeRange, type Band } from "../lib/orbit.ts";
import { dayOf, questionOn } from "../lib/questions.ts";
import { SKY_CAP, launch, nextLaunchAt, satellitesOf, skyIsFull, waitMessage } from "../lib/sky.ts";

// The launchpad. The form posts here and works without JavaScript: a launch
// redirects to the sky, a refusal re-renders the form with the reasons. The
// page's script asks for JSON instead, so it can play the launch first.
const { person, operator } = Astro.locals;
const viewer = { person, operator: operator?.id ?? null };
const wantsJson = Astro.request.headers.get("accept")?.includes("application/json");

let errors: LaunchErrors = {};
let values: LaunchValues = { band: "low", callsign: "", beacon: "", answering: "1" };

let form: FormData | undefined;
if (Astro.request.method === "POST") {
  try {
    form = await Astro.request.formData();
  } catch {
    errors = { form: "That launch form couldn't be read. Fill it in and try again." };
    if (wantsJson) return Response.json({ errors }, { status: 400 });
    Astro.response.status = 400;
  }
}

if (form) {
  const read = readLaunch(form);
  const result = read.ok ? launch(viewer, read.input) : read;
  if (result.ok) {
    const redirect = `/sky/?launched=${result.object.id}`;
    if (wantsJson) return Response.json({ id: result.object.id, redirect }, { status: 201 });
    return Astro.redirect(redirect, 303);
  }
  if (wantsJson) return Response.json({ errors: result.errors }, { status: 422 });
  errors = result.errors;
  if (!read.ok) values = read.values;
  else
    values = {
      band: read.input.band,
      callsign: read.input.callsign,
      beacon: read.input.beacon,
      answering: form.get("answering") ? "1" : "",
    };
  Astro.response.status = 422;
}

// you can have any number up, a short gap apart (PLAN.md, "Launch limits")
const mine = satellitesOf(viewer);
const wait = nextLaunchAt(viewer) - Date.now();
const full = skyIsFull();
const names = (list: string[]) =>
  list.length < 2 ? list.join("") : `${list.slice(0, -1).join(", ")} and ${list[list.length - 1]}`;
const bands = Object.entries(BANDS) as [Band, (typeof BANDS)[Band]][];
const hint: Record<Band, string> = {
  low: "Heard most often.",
  mid: "A middle course.",
  high: "Heard least often.",
};
// everything falls (ADR 0007): the lower, the sooner, and where in the band
// a launch lands decides how soon
const life = (band: Band) => {
  const { shortest, longest } = lifetimeRange(band);
  return `Burns up in ${lasting(shortest, longest)}.`;
};
// the stations' question today (ADR 0018), and which day's this form shows
const today = dayOf(Date.now());
const question = questionOn(today);
// the error is always referenced, even empty, so the script can fill it in
const describe = (field: keyof LaunchErrors, help?: string) =>
  [`${field}-error`, help].filter(Boolean).join(" ");
---
<Base title="Kessler: the launchpad" current="launchpad">
  <main class="pad">
    <div class="scene" aria-hidden="true">
      <div class="stars"></div>
      <svg class="gantry" viewBox="0 0 120 260" preserveAspectRatio="xMidYMax meet">
        <g class="tower" stroke="#3a5781" stroke-width="2" fill="none">
          <path d="M20 260V40M44 260V40M20 40h24" />
          <path d="M20 60l24 20M44 60L20 80M20 100l24 20M44 100l-24 20M20 140l24 20M44 140l-24 20M20 180l24 20M44 180l-24 20M20 220l24 20M44 220l-24 20" />
          <path d="M44 90h26M44 170h26" />
        </g>
        <g class="rocket">
          <g class="flame">
            <path d="M80 236c0 14 5 22 8 30 3-8 8-16 8-30z" fill="#f2a541" />
            <path d="M84 236c0 8 2 14 4 19 2-5 4-11 4-19z" fill="#fff3d6" />
          </g>
          <path d="M88 40c-9 12-12 30-12 48v148h24V88c0-18-3-36-12-48z" fill="#dbe4ef" />
          <path d="M76 200l-12 22v14h12zM100 200l12 22v14h-12z" fill="#93a6bf" />
          <circle cx="88" cy="110" r="5" fill="#0e1a30" stroke="#93a6bf" stroke-width="2" />
          <path d="M76 160h24" stroke="#93a6bf" stroke-width="2" />
        </g>
      </svg>
      <div class="ground"></div>
    </div>
    <canvas class="pad-view" id="pad-view" aria-hidden="true"></canvas>
    <div class="fade" aria-hidden="true"></div>

    <div class="hud" id="hud" aria-hidden="true" hidden>
      <p class="hud-mission"><span id="hud-callsign"></span> <span class="hud-dim">to</span> <span id="hud-band"></span></p>
      <p class="hud-clock" id="hud-clock">T+ 00:00.0</p>
      <dl class="hud-readouts">
        <div><dt>Alt</dt><dd><span id="hud-alt">0.0</span> km</dd></div>
        <div><dt>Vel</dt><dd><span id="hud-vel">0.00</span> km/s</dd></div>
      </dl>
    </div>
    <button type="button" class="skip" id="skip" hidden>Skip to the sky ›</button>
    <p class="visually-hidden" role="status" id="launch-status"></p>

    <section class="intro">
      <h1>Kessler</h1>
      <p class="lede">
        Say one thing to everyone who's here. Your line goes up on a satellite,
        and whoever has the sky open hears it each time it passes over a ground
        station.
      </p>
      <p class="lede">
        But the sky is shared, and every launch crowds it. When two satellites
        collide, their words break into each other and keep broadcasting as
        static, over everyone else's.
      </p>
      <p class="lede ask">What's worth saying, if saying it costs everyone a little?</p>
      <a class="explainer" href="/why/">
        <span class="explainer-kicker">New here?</span>
        <span>What this is, and why <span aria-hidden="true">→</span></span>
      </a>
      <a class="explainer-more" href="/kessler/">What's Kessler syndrome?</a>
    </section>

    <section class="console" aria-labelledby="launch-title">
      <h2 id="launch-title">Launch a satellite</h2>

      {mine.length > 0 && (
        <p class="notice">
          {mine.length === 1 ? "Yours in orbit: " : `Yours in orbit (${mine.length}): `}
          <strong>{names(mine.map((o) => o.callsign ?? "unnamed"))}</strong>. Another
          launch is another beacon heard, and one more thing for everyone to share the
          sky with. <a href="/sky/">Watch the sky</a>
        </p>
      )}

      {wait > 0 && !errors.form && (
        <p class="notice" id="launch-wait" data-wait={wait}>{waitMessage(wait)}</p>
      )}

      {full && (
        <p class="notice full">
          The sky is full: {SKY_CAP} satellites in orbit, the most it holds.
          <a href="/sky/">Watch the sky</a>
        </p>
      )}

      <div class="form-error" role="alert" id="form-error">{errors.form}</div>

      <form method="post" action="/" novalidate data-launch>
        <fieldset disabled={wait > 0 || full}>
          <fieldset class="bands" aria-describedby={describe("band")}>
            <legend>Altitude</legend>
            {bands.map(([band, b]) => (
              <label class="band">
                <input type="radio" name="band" value={band} checked={values.band === band} />
                <span class="band-name">{b.label}</span>
                <span class="band-period">round the planet every {every(b.period)}</span>
                <span class="band-hint">{hint[band]} <span class="band-life">{life(band)}</span></span>
              </label>
            ))}
            <p class="field-error" id="band-error" data-error="band">{errors.band}</p>
          </fieldset>

          <div class="field">
            <label for="callsign">Callsign</label>
            <input
              id="callsign"
              name="callsign"
              required
              maxlength={CALLSIGN_MAX}
              autocomplete="off"
              spellcheck="false"
              value={values.callsign}
              aria-invalid={errors.callsign ? "true" : undefined}
              aria-describedby={describe("callsign", "callsign-help")}
            />
            <p class="help" id="callsign-help">
              Up to {CALLSIGN_MAX} letters or numbers, shown beside your satellite.
            </p>
            <p class="field-error" id="callsign-error" data-error="callsign">{errors.callsign}</p>
          </div>

          <div class="field">
            <!-- the stations' question (ADR 0018): a prompt, never a rule -->
            <p class="today">
              <span class="today-kicker">Today the stations ask</span>
              <span class="today-question" id="question">{question}</span>
            </p>
            <label for="beacon">Beacon</label>
            <textarea
              id="beacon"
              name="beacon"
              rows="2"
              required
              maxlength={BEACON_MAX}
              autocomplete="off"
              aria-invalid={errors.beacon ? "true" : undefined}
              aria-describedby={describe("beacon", "question beacon-help")}
            >{values.beacon}</textarea>
            <label class="answering">
              <input type="checkbox" name="answering" value="1" checked={values.answering === "1"} />
              <span>It answers today's question</span>
            </label>
            <input type="hidden" name="asked" value={today} />
            <p class="help" id="beacon-help">
              <span>Up to {BEACON_MAX} characters, no links. Kept on record after
              it's gone.</span>
              <span class="count" id="beacon-count" aria-hidden="true" hidden></span>
            </p>
            <p class="field-error" id="beacon-error" data-error="beacon">{errors.beacon}</p>
          </div>

          <button type="submit">Launch</button>
        </fieldset>
      </form>

      <!-- a nudge, never a gate: anyone can launch (ADR 0009) -->
      {operator ? (
        <p class="launch-as">Launching as <strong>{operator.handle}</strong>.</p>
      ) : (
        <p class="launch-as">
          Launching without a handle. <a href="/operator/?back=launchpad">Claim one</a> to keep
          your satellites on any device, and your name on what they do.
        </p>
      )}
    </section>

    <!-- the same offer as a pop-up on the first Launch of a visit; skipping
         it launches without one, as before (ADR 0009) -->
    {!operator && !form && (
      <dialog class="handle-prompt" id="handle-prompt" aria-labelledby="handle-prompt-title">
        <div class="handle-prompt-body">
          <h2 id="handle-prompt-title">Launch under a handle?</h2>
          <p>
            Without one, what you launch is tied to this browser: clear your cookies
            or switch devices and it's no longer yours. With one, your satellites
            follow you, and when they collide, every screen names you.
          </p>
          <div class="handle-prompt-actions">
            <a class="handle-prompt-claim" href="/operator/?back=launchpad">Claim a handle</a>
            <a href="/operator/?back=launchpad#sign-in-title">I have one: sign in</a>
          </div>
          <form method="dialog">
            <button type="submit" class="handle-prompt-skip" value="launch">Launch without a handle</button>
          </form>
        </div>
      </dialog>
    )}
  </main>

  <script>
    import { readLaunch } from "../lib/launch.ts";

    // Opens the handle pop-up on the first Launch of a visit, before the
    // launch goes anywhere. "Launch without a handle" carries the launch on;
    // Escape or the backdrop just closes it. Without this script it never
    // opens, and the line under the Launch button makes the offer.
    //
    // Only for a launch that would go ahead: one with a field missing or
    // refused goes straight on, so the form says what's wrong (the server
    // has the last word, as ever), and the offer waits for a launch worth
    // making.
    const prompt = document.getElementById("handle-prompt") as HTMLDialogElement | null;
    const SEEN = "kessler:handle-prompt";
    const launch = document.querySelector<HTMLFormElement>("form[data-launch]");
    let seen = false;
    try {
      seen = sessionStorage.getItem(SEEN) !== null;
    } catch {
      // no storage: show it, as for a first visit
    }
    if (prompt && launch && !seen) {
      // captured on the document, so it runs before the launch's own handler
      document.addEventListener(
        "submit",
        (e) => {
          if (seen || e.target !== launch || !readLaunch(new FormData(launch)).ok) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          seen = true;
          // seen, however it's left: launched, closed, or followed to the operator page
          try {
            sessionStorage.setItem(SEEN, "1");
          } catch {
            // shown again next visit, which is fine
          }
          // what an earlier try said is wrong is fixed now
          for (const el of launch.querySelectorAll("[data-error]")) el.textContent = "";
          for (const el of launch.querySelectorAll("[aria-invalid]")) el.removeAttribute("aria-invalid");
          prompt.returnValue = "";
          prompt.showModal();
        },
        { capture: true },
      );
      prompt.addEventListener("close", () => {
        if (prompt.returnValue === "launch") launch.requestSubmit();
      });
      // a click on the backdrop closes it too (the content fills the box)
      prompt.addEventListener("click", (e) => {
        if (e.target === prompt) prompt.close();
      });
    }
  </script>

  <script>
    // How much of the beacon is left, as it's written (the field stops at
    // the limit itself).
    const beacon = document.querySelector<HTMLTextAreaElement>("textarea[name=beacon]");
    const counter = document.getElementById("beacon-count");
    if (beacon && counter) {
      const max = beacon.maxLength;
      const show = () => {
        const used = [...beacon.value].length;
        counter.textContent = `${used} / ${max}`;
        counter.classList.toggle("near", used > max - 20);
      };
      counter.hidden = false;
      beacon.addEventListener("input", show);
      show();
    }
  </script>

  <script>
    // Keeps what's been filled in across a detour to claim a handle or sign
    // in: saved on following one of the launchpad's own links to the operator
    // page (they come back here), filled back in only when arriving from that
    // page, and dropped otherwise.
    const DRAFT = "kessler:launch-draft";
    const pad = document.querySelector<HTMLFormElement>("form[data-launch]");
    const field = (name: string) => pad?.querySelector<HTMLInputElement | HTMLTextAreaElement>(`:is(input, textarea)[name=${name}]:not([type=radio])`);
    if (pad) {
      document.addEventListener("click", (e) => {
        if (!(e.target instanceof Element) || !e.target.closest('a[href^="/operator/?back=launchpad"]')) return;
        const draft = {
          band: pad.querySelector<HTMLInputElement>("input[name=band]:checked")?.value,
          callsign: field("callsign")?.value ?? "",
          beacon: field("beacon")?.value ?? "",
        };
        if (!draft.callsign && !draft.beacon && draft.band === "low") return;
        try {
          sessionStorage.setItem(DRAFT, JSON.stringify(draft));
        } catch {
          // no storage: the form starts empty again, as before
        }
      });
      // back without leaving (the page restored from the cache): nothing to fill in
      addEventListener("pageshow", (e) => {
        try {
          if (e.persisted) sessionStorage.removeItem(DRAFT);
        } catch {
          // nothing was saved
        }
      });
      const draft = ((): { band?: string; callsign?: string; beacon?: string } | null => {
        try {
          const saved = sessionStorage.getItem(DRAFT);
          sessionStorage.removeItem(DRAFT);
          return JSON.parse(saved ?? "null");
        } catch {
          // nothing saved, or unreadable: start empty
          return null;
        }
      })();
      const fromOperator = (() => {
        try {
          const from = new URL(document.referrer);
          return from.origin === location.origin && from.pathname === "/operator/";
        } catch {
          return false;
        }
      })();
      // only into a fresh form, never over a refused launch's own values
      if (draft && fromOperator && !field("callsign")?.value && !field("beacon")?.value) {
        const band = [...pad.querySelectorAll<HTMLInputElement>("input[name=band]")].find((r) => r.value === draft.band);
        if (band) band.checked = true;
        field("callsign")!.value = String(draft.callsign ?? "");
        field("beacon")!.value = String(draft.beacon ?? "");
        field("beacon")!.dispatchEvent(new Event("input"));
      }
    }
  </script>

  <script>
    // Counts down the gap between your launches, and opens the form when
    // it's over. Without this script, reloading the page does the same.
    const notice = document.getElementById("launch-wait");
    if (notice) {
      const ready = Date.now() + Number(notice.dataset.wait);
      const tick = setInterval(() => {
        const left = ready - Date.now();
        if (left > 0) {
          // as waitMessage in src/lib/sky.ts
          const seconds = Math.ceil(left / 1000);
          const minutes = Math.floor(seconds / 60);
          const rest = seconds % 60;
          const when = minutes > 0 ? `${minutes} min ${String(rest).padStart(2, "0")} s` : `${rest} s`;
          notice.textContent = `You can launch again in ${when}.`;
          return;
        }
        clearInterval(tick);
        notice.remove();
        document.querySelector<HTMLFieldSetElement>("form[data-launch] > fieldset")!.disabled =
          document.querySelector(".notice.full") !== null;
      }, 250);
    }
  </script>

  <script>
    import type { Framing, PadControls } from "../scripts/launchpad.ts";

    // Plays the launch before going to the sky: ignition, liftoff, and the
    // camera following the rocket up until the ground is the planet's limb,
    // where the sky page takes over. Without this script the form posts and
    // redirects as normal; without WebGL the drawn rocket lifts off instead.
    const form = document.querySelector<HTMLFormElement>("form[data-launch]")!;
    const formError = document.getElementById("form-error")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const narrow = matchMedia("(max-width: 52rem)");
    const intro = document.querySelector<HTMLElement>(".intro")!;
    const panel = document.querySelector<HTMLElement>(".console")!;
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);

    // Where the rocket stands on the page: in the open ground between the
    // intro and the form, close up (20rem, more where there's room under the
    // intro), smaller only where that ground is too narrow or the screen under
    // the header too short for it, down to 9rem; on a phone, in the gutter
    // beside the intro, scrolling with it.
    function measure(width: number, height: number): Framing {
      // the text itself, not its grid cell, which stretches to the form's height
      const lines = [...intro.children].map((el) => el.getBoundingClientRect());
      if (narrow.matches) {
        // the horizon just above the form, which hides the ground below it
        return { x: width - 1.9 * rem, y: panel.getBoundingClientRect().top - 0.75 * rem, height: 9 * rem };
      }
      const ground = height - 2.5 * rem;
      // where the text ends unscrolled: the canvas is fixed, so the rocket
      // keeps its size while the page scrolls under it
      const bottom = Math.max(...lines.map((r) => r.bottom)) + scrollY;
      const room = (ground - bottom - 2 * rem) * 0.78;
      const right = Math.max(...lines.map((r) => r.right));
      const left = panel.getBoundingClientRect().left;
      // the tower and rocket are about 0.4 of the height across, and the
      // mast stands about 1.3 times the height above the ground
      const fits = Math.min((left - right) / 0.45, (ground - 5 * rem) / 1.3);
      return {
        x: (right + left) / 2,
        y: ground,
        height: Math.max(9 * rem, Math.min(26 * rem, Math.max(20 * rem, room), fits)),
      };
    }
    // measured again only when the layout can have moved, not every frame
    let framing: Framing | null = null;
    let measuredAt = "";
    const remeasure = () => (framing = null);
    addEventListener("scroll", remeasure, { passive: true });
    addEventListener("resize", remeasure);
    document.fonts?.ready.then(remeasure);
    function frame(width: number, height: number): Framing {
      if (!framing || measuredAt !== `${width}x${height}`) {
        framing = measure(width, height);
        measuredAt = `${width}x${height}`;
      }
      return framing;
    }

    let scene: PadControls | null = null;
    import("../scripts/launchpad.ts")
      .then(({ createPad }) => {
        scene = createPad({
          canvas: document.getElementById("pad-view") as HTMLCanvasElement,
          frame,
          reduced,
          // the drawn rocket comes back if the scene stops
          lost: () => document.body.classList.remove("has-scene"),
        });
        if (scene) document.body.classList.add("has-scene");
      })
      // the chunk didn't load, or WebGL isn't there: the drawn rocket stays
      .catch(() => {});

    function showErrors(errors: Record<string, string>) {
      formError.textContent = errors.form ?? "";
      for (const el of form.querySelectorAll<HTMLElement>("[data-error]")) {
        const field = el.dataset.error!;
        el.textContent = errors[field] ?? "";
        const input = form.querySelector(`#${field}`);
        if (errors[field]) input?.setAttribute("aria-invalid", "true");
        else input?.removeAttribute("aria-invalid");
      }
      const first = Object.keys(errors).find((f) => f !== "form");
      form.querySelector<HTMLElement>(first === "band" ? "[name=band]" : `#${first}`)?.focus();
    }

    // The mission readout over the launch.
    const hud = document.getElementById("hud")!;
    const clock = document.getElementById("hud-clock")!;
    const alt = document.getElementById("hud-alt")!;
    const vel = document.getElementById("hud-vel")!;
    const twoDigits = (n: number) => String(Math.floor(n)).padStart(2, "0");

    function play(redirect: string) {
      let going = false;
      const go = () => {
        if (going || !redirect) return;
        going = true;
        location.assign(redirect);
      };
      const data = new FormData(form);
      const callsign = String(data.get("callsign") ?? "");
      const band = form.querySelector<HTMLInputElement>("[name=band]:checked")?.closest("label")?.querySelector(".band-name")?.textContent ?? "";
      // set a moment after the form goes inert, so screen readers announce it
      setTimeout(() => {
        document.getElementById("launch-status")!.textContent = `Launching ${callsign} to the ${band.toLowerCase()} band.`;
      }, 100);
      form.inert = true;
      document.body.classList.add("launching");
      // the sky page loads while the launch plays
      const prefetch = document.createElement("link");
      prefetch.rel = "prefetch";
      prefetch.href = redirect;
      document.head.append(prefetch);

      if (!scene) {
        setTimeout(go, 2400);
        return;
      }
      document.getElementById("hud-callsign")!.textContent = callsign;
      document.getElementById("hud-band")!.textContent = `${band} orbit`;
      hud.hidden = false;
      const skip = document.getElementById("skip")!;
      skip.hidden = false;
      skip.focus();
      skip.addEventListener("click", go);
      addEventListener("keydown", (e) => e.key === "Escape" && go());
      // whatever happens to the scene, the sky is never more than ten
      // seconds away
      setTimeout(go, 10_000);
      scene
        .launch(({ time, altitude, speed }) => {
          clock.textContent = `T+ ${twoDigits(time / 60)}:${twoDigits(time % 60)}.${Math.floor((time * 10) % 10)}`;
          alt.textContent = altitude.toFixed(1);
          vel.textContent = speed.toFixed(2);
        })
        .then(() => {
          // a fade to the dark the sky page opens on
          document.body.classList.add("arrived");
          setTimeout(go, 450);
        });
    }

    // a dry run in development, to watch the launch without launching
    if (import.meta.env.DEV) Object.assign(window, { dryRun: () => play("") });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button")!;
      button.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { accept: "application/json" },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        });
        const body = res.headers.get("content-type")?.includes("json") ? await res.json() : {};
        if (!res.ok) {
          showErrors(body.errors ?? { form: `The launchpad refused the launch (${res.status}). Try again.` });
          button.disabled = false;
          return;
        }
        showErrors({});
        // the launch went through, so the sky is where to go regardless
        const redirect = typeof body.redirect === "string" ? body.redirect : "/sky/";
        if (reduced) return location.assign(redirect);
        play(redirect);
      } catch {
        showErrors({ form: "Couldn't reach the launchpad. Check your connection and try again." });
        button.disabled = false;
      }
    });

    // Back from the sky, the page may come back mid-launch from the cache.
    addEventListener("pageshow", (e) => {
      if (e.persisted && document.body.classList.contains("launching")) location.reload();
    });
  </script>
</Base>


<style>
  .pad {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
