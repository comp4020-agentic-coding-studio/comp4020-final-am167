{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "astro check && tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run",
    "test:layout": "vitest run --config vitest.layout.config.ts",
    "dev": "node scripts/migrate.mjs && astro dev",
    "build": "astro build",
    "start": "node scripts/migrate.mjs && node dist/server/entry.mjs",
    "db:generate": "drizzle-kit generate",
    "coastline": "node scripts/coastline.mjs",
    "test:performance:budgets": "pnpm build && vitest run --config vitest.performance.config.ts",
    "test:performance:browser": "pnpm build && node scripts/performance/run.ts",
    "test:performance": "pnpm test:performance:budgets && node scripts/performance/run.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.0",
    "playwright-core": "1.55.0",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "astro": "^7.3.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.0.14",
    "three": "^0.186.1"
  }
}
